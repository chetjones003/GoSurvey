// GENERATED FILE — do not edit. CMake configures this from resources/version.rc.in.
//
// Kept separate from app.rc on purpose: app.rc resolves "app.ico" relative to its own
// location, so configuring it into the build tree would break that path. The icon stays
// where it is; only the version block is generated (ADR-029 (a)).
//
// FILEVERSION/PRODUCTVERSION must be a numeric quad, so a prerelease build carries its
// beta number in the fourth field and states the full "0.5.0-beta.7" form in the string
// block, which is the one a human reads.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@GOSURVEY_VERSION_BUILD@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@GOSURVEY_VERSION_BUILD@
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Chet Jones"
            // ASCII only: llvm-rc reads this file in the current codepage and rejects an
            // 8-bit codepoint outright, so no em dash here even though the UI uses one.
            VALUE "FileDescription",  "GoSurvey - survey and CAD"
            VALUE "FileVersion",      "@PROJECT_VERSION@@GOSURVEY_VERSION_SUFFIX@"
            VALUE "InternalName",     "GoSurvey"
            VALUE "OriginalFilename", "GoSurvey.exe"
            VALUE "ProductName",      "GoSurvey"
            VALUE "ProductVersion",   "@PROJECT_VERSION@@GOSURVEY_VERSION_SUFFIX@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
