#!/usr/bin/env bash
# dev/codeql — local whole-codebase CodeQL analysis (REQ-402, issue #801).
#
# Why this exists: CodeQL (.github/workflows/codeql.yml) does whole-program analysis — it
# builds a database from the ENTIRE compiled codebase and runs dataflow queries across it,
# the same cost no matter how small a PR is. That measured at 1-3 hours per run on this
# codebase, which is fine for the infrequent beta->master release PRs it now gates (REQ-402)
# but far too slow to use as a quick local check. This script exists for the one-time (or
# occasional) whole-codebase triage pass instead: run it locally, fix what it finds, done —
# not something to run before every commit.
#
# Mirrors .github/workflows/codeql.yml exactly: cpp-security-and-quality query suite. Applies
# the same paths-ignore as .github/codeql/codeql-config.yml (third_party/, build/, samples/)
# as a SARIF post-filter — the CLI's `database analyze` has no equivalent of that Actions-only
# config, so dev/codeql-filter.ps1 does it after the fact instead.
#
# Prerequisite (one-time): download the CodeQL CLI bundle and extract it to
#   %LOCALAPPDATA%\codeql-cli\codeql\codeql.exe
# (bundle download: https://github.com/github/codeql-action/releases, codeql-bundle-win64.tar.gz)
#
# Budget 1-3 hours: this does a full clean rebuild under CodeQL's build tracer so every
# translation unit actually gets traced, then runs the full query suite.
#
# Output (repo root, both gitignored):
#   codeql-results.sarif           raw SARIF, everything CodeQL found including third_party/
#   codeql-results-filtered.sarif  first-party findings only — open this one
source "$(dirname "$0")/_common.sh"

CODEQL_EXE_WIN='%LOCALAPPDATA%\codeql-cli\codeql\codeql.exe'
CODEQL_DB=".codeql-db"
SARIF_RAW="codeql-results.sarif"
SARIF_FILTERED="codeql-results-filtered.sarif"
SUITE='codeql/cpp-queries:codeql-suites/cpp-security-and-quality.qls'

info "full clean rebuild + CodeQL database create + analyze -- this takes 1-3 hours."
info "database:  $CODEQL_DB"
info "raw sarif: $SARIF_RAW"

win_cmd "$(cat <<BATCH
if exist "$CODEQL_DB" rmdir /s /q "$CODEQL_DB"
if exist build rmdir /s /q build
echo [dev/codeql] creating database (full build under the CodeQL tracer) ...
"$CODEQL_EXE_WIN" database create "$CODEQL_DB" --language=cpp --source-root=. --command="call build.bat" --overwrite
if errorlevel 1 exit /b 1
echo [dev/codeql] running cpp-security-and-quality ...
"$CODEQL_EXE_WIN" database analyze "$CODEQL_DB" --format=sarifv2.1.0 --output="$SARIF_RAW" --threads=0 $SUITE
if errorlevel 1 exit /b 1
echo [dev/codeql] filtering results (excludes third_party/build/samples) ...
powershell -NoProfile -ExecutionPolicy Bypass -File dev\\codeql-filter.ps1 -InputSarif "$SARIF_RAW" -OutputSarif "$SARIF_FILTERED"
BATCH
)"

info "done. Open $SARIF_FILTERED in VS Code (SARIF Viewer extension) to jump to each finding."
