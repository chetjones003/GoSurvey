#!/usr/bin/env bash
# dev/run — launch the built GoSurvey executable.
#
# Delegates to run.bat, which picks build\GoSurvey.exe (release) or
# build\debug\GoSurvey.exe (debug) — whichever is present, or the more recently
# built one when both exist. Does not build; run ./dev/build first.
#
#   ./dev/run                 # run whichever build is present
#   ./dev/run release         # force the release build
#   ./dev/run debug           # force the debug build
#   ./dev/run -- --some-flag   # forward args to GoSurvey.exe
#
# This starts a GUI process on the Windows desktop; from a headless shell it
# will launch but you will not see a window. Exit code is run.bat's.
source "$(dirname "$0")/_common.sh"

info "launching GoSurvey ..."
# `.\` is required: this shell runs with NoDefaultCurrentDirectoryInExePath set,
# so cmd.exe will not resolve run.bat from the working directory alone.
win_cmd "call .\\run.bat $*"
