#!/usr/bin/env bash
# dev/build — invoke GoSurvey's canonical Windows build.
#
# Delegates to build.bat (sources vcvars64, configures the ninja-release preset
# on first run, then `cmake --build build`). Extra arguments are forwarded to
# `cmake --build`, e.g.:
#
#   ./dev/build                       # incremental release build
#   ./dev/build --target GoSurveyTests
#   ./dev/build --clean-first
#   ./dev/build -- -v                 # verbose ninja output
#
# Exit code is build.bat's exit code (0 = success, non-zero = failure).
source "$(dirname "$0")/_common.sh"

info "building GoSurvey (Windows MSVC/Ninja, release) ..."
# `.\` is required: this shell runs with NoDefaultCurrentDirectoryInExePath set,
# so cmd.exe will not resolve build.bat from the working directory alone.
win_cmd "call .\\build.bat $*"
