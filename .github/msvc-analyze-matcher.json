{
  "problemMatcher": [
    {
      "owner": "msvc-analyze",
      "pattern": [
        {
          "regexp": "^\\s*(.*)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s*warning\\s+(C\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    }
  ]
}
