#!/bin/sh
# REQ-336 — block push of resources/whats-new.md unless a one-time unlock exists.
# Unlock: run tools/approve-whats-new.ps1 (or create .whats-new-push-unlock) after Chet reviews.

set -e

UNLOCK=".whats-new-push-unlock"
PROTECTED="resources/whats-new.md"

needs_unlock=0
while read -r local_ref local_sha remote_ref remote_sha
do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="${remote_sha}..${local_sha}"
  fi
  if git diff --name-only "$range" 2>/dev/null | grep -qx "$PROTECTED"; then
    needs_unlock=1
  fi
done

if [ "$needs_unlock" -eq 0 ]; then
  exit 0
fi

if [ ! -f "$UNLOCK" ]; then
  echo "REFUSED: $PROTECTED is in this push, but $UNLOCK is missing." >&2
  echo "Chet must review the What's New notes, then run:" >&2
  echo "  pwsh tools/approve-whats-new.ps1" >&2
  echo "or say: I reviewed the billboard notes and approve — unlock for push." >&2
  exit 1
fi

rm -f "$UNLOCK"
echo "REQ-336: $PROTECTED push allowed (one-time unlock consumed)."
exit 0
