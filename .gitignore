# --- CMake / build ---
/build/
/build-debug/
/build-release/
/out/
/cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
_install/
.cache/clangd/
compile_commands.json
gosurvey_imgui.ini

# --- Installer ---
# The script that produces the shipped artifact MUST be tracked (ADR-029 (c)) — CI cannot
# build a release from a file that is not in the repository. Everything else under
# installer/ stays ignored: the built setup .exe, and the superseded per-version scripts
# (0.3.1.iss, 0.4.0.iss) that GoSurvey.iss replaces.
/installer/*
!/installer/GoSurvey.iss
!/installer/License.txt
!/installer/InfoAfter.txt

# --- Compiled artifacts (also produced beside tree sometimes) ---
*.exe
*.dll
*.lib
*.exp
*.obj
*.o
*.a
*.pdb
*.ilk
*.idb

# ...but the vendored prebuilt dependency binaries ARE tracked (D-2026-08-31-b).
!third_party/**/*.dll
!third_party/**/*.lib
!third_party/**/*.a
*.pch

