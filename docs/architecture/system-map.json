    "Core": {
      "tier": "T0 Foundation",
      "audit": {
        "issue": 1220,
        "parent": 1207,
        "commit": "a31a9d63",
        "codeMoved": false
      },
      "responsibility": "Provides shared application services: logging, settings values, unit definitions and conversions, number, angle and duration formatting, and string helpers.",
      "doesNotOwn": [
        "geometry algorithms",
        "domain entities and per-drawing storage (the DrawingSettings struct stays in Document)",
        "UI widgets and visibility flags",
        "platform APIs (Win32 %TEMP% paths, file dialogs)",
        "file formats and font files (src/font is a mis-mapping, see auditFindings)"
      ],
      "allowedDependencies": [],
      "currentFiles": [
        "src/core/include/GoSurvey/Core/AngleFormat.hpp",
        "src/core/include/GoSurvey/Core/NumFormat.hpp",
        "src/core/include/GoSurvey/Core/StringUtil.hpp",
        "src/core/src/Core.cpp"
      ],
      "pendingAssignment": [
        {
          "files": [
            "src/util/SaveTrace.hpp",
            "src/util/SaveTrace.cpp"
          ],
          "reason": "Core logging sink, but io/DwgIo.cpp and io/LibreDwgCad.cpp include util/SaveTrace.hpp as a private header. Assigning it to Core now would add two private-header violations. The move ticket must add GoSurvey/Core/SaveTrace.hpp, switch the two includes, then map the files to Core. The file is temporary diagnostics for issue #167, so deleting it is also an option."
        }
      ],
      "outsideScan": [
        "internal/core/CorePrivate.hpp: private header for Core.cpp. It is outside src/, so the ratchet does not scan it. Move it with Core."
      ],
