foreach(name GoSurvey GoSurveyTestImGui GoSurveyQt GoSurveyQtTests)
  if(NOT EXISTS "${RUNTIME_DIR}/${name}.exe")
    message(FATAL_ERROR "Missing application: ${RUNTIME_DIR}/${name}.exe")
  endif()
endforeach()
file(GLOB executables "${RUNTIME_DIR}/*.exe")
list(REMOVE_ITEM executables "${RUNTIME_DIR}/vc_redist.x64.exe")
list(LENGTH executables count)
if(NOT count EQUAL 4)
  message(FATAL_ERROR "Expected four application executables, found: ${executables}")
endif()
file(GLOB clutter "${RUNTIME_DIR}/*.png" "${RUNTIME_DIR}/*.lib"
  "${RUNTIME_DIR}/*.exp" "${RUNTIME_DIR}/*.obj" "${RUNTIME_DIR}/*.pdb")
if(clutter OR EXISTS "${RUNTIME_DIR}/CMakeCache.txt" OR EXISTS "${RUNTIME_DIR}/CMakeFiles")
  message(FATAL_ERROR "Build intermediates or test captures beside applications: ${clutter}")
endif()
